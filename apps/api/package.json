{
  "name": "@razorrecover/api",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrator.ts",
    "db:rollback": "tsx src/db/migrator.ts rollback",
    "db:seed": "tsx src/db/seed.ts",
    "test": "node --test dist/tests/**/*.test.js || echo 'No compiled tests yet'"
  },
  "dependencies": {
    "@razorrecover/policy-engine": "*",
    "@razorrecover/shared-types": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
