{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@razorrecover/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@razorrecover/policy-engine": ["../../packages/policy-engine/src/index.ts"],
      "@razorrecover/recovery-engine": ["../../packages/recovery-engine/src/index.ts"],
      "@razorrecover/evaluation": ["../../packages/evaluation/src/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/shared-types/src/**/*",
    "../../packages/policy-engine/src/**/*",
    "../../packages/recovery-engine/src/**/*",
    "../../packages/evaluation/src/**/*"
  ]
}
