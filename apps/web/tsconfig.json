{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@razorrecover/shared-types": ["../../packages/shared-types/dist/index.d.ts"],
      "@razorrecover/policy-engine": ["../../packages/policy-engine/dist/index.d.ts"],
      "@razorrecover/recovery-engine": ["../../packages/recovery-engine/dist/index.d.ts"],
      "@razorrecover/evaluation": ["../../packages/evaluation/dist/index.d.ts"]
    }
  },
  "include": ["src"]
}
