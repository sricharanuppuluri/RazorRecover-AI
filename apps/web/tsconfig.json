{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@razorrecover/shared-types": [
        "../../packages/shared-types/src/index.ts",
        "../../packages/shared-types/dist/index.d.ts"
      ],
      "@razorrecover/policy-engine": [
        "../../packages/policy-engine/src/index.ts",
        "../../packages/policy-engine/dist/index.d.ts"
      ],
      "@razorrecover/recovery-engine": [
        "../../packages/recovery-engine/src/index.ts",
        "../../packages/recovery-engine/dist/index.d.ts"
      ],
      "@razorrecover/evaluation": [
        "../../packages/evaluation/src/index.ts",
        "../../packages/evaluation/dist/index.d.ts"
      ]
    }
  },
  "include": ["src"]
}
