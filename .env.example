# RazorRecover AI - Environment Variable Configuration Template
# DO NOT ADD REAL SECRETS TO THIS FILE

# Application Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Razorpay Integration (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/razorrecover

# AI / LLM Configuration
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Security & Sessions
SESSION_SECRET=dev-secret-change-in-production

# External Services / Redis / Notifications
NOTIFICATION_PROVIDER_KEY=
REDIS_URL=redis://localhost:6379
